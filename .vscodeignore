.vscode/**
.vscode-test/**
.devcontainer/**
.github/**
.git/**

# Source (bundled into out/ by esbuild)
src/**
**/*.ts
**/*.map
tsconfig.json

# Linters/formatters/configs
eslint.config.mjs
.eslintrc.json
.prettier*
.editorconfig
.gitignore

# Node/dev artifacts
node_modules/**
package-lock.json
yarn.lock
pnpm-lock.yaml

# Tests and docs (not required in VSIX)
test/**
tests/**
out-test/**
docs/**
CONTRIBUTING.md
CODE_OF_CONDUCT.md
PROJECT_SUMMARY.md
INSTALLATION_TESTING.md
tsconfig.test.json

# Stale release artifacts that must never ship inside the extension
*.zip

# Misc — exclude root build artifacts, but keep the portable installer's
# bundled vsix embedded in the package (see AGENTS.md §6 release workflow)
*.vsix
!install_build/**/*.vsix
*.log
.DS_Store
Thumbs.db
